vern mixed-license components\n\nAcceptance criteria\n\nLicense evidence and acquired bytes are digest-bound\nFixture approvals are clearly synthetic","encoding":"UTF-8","media_type":"text/markdown"},"resolved_task_block_sha256":"764cf6b15650867fe17f19894cd1d31b086350dae9e1ddf70c2ff748a987c15a","successor_task_keys":["07A"],"task_key":"07","task_schema_version":"1.0.0"},"envelope_sha256":"972966739c65c509662c9a47614c72d3765229ab23b2f53e407f39ed24323b40","record_id":"envelope-07-20260914T140604Z","record_sha256":"972966739c65c509662c9a47614c72d3765229ab23b2f53e407f39ed24323b40","signature_algorithm":"Ed25519","signature_b64":"0CooMwDTP9cdSOGU/iJBG43gEq/KcBRoVYpTnFgLX3XMuFF8xuR8v+THkUFMtaNUNl/jGhJmVEtvCCZBiY+RAA=="}
