      {
        "context_key": "context:te:wb-jude",
        "scope_key": "scope:wb-jude:refsys:tel-v1:jude.1.1-jude.1.25",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, యేసు, యూదా, అబద్ధ ఉపదేశకులు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "కలుషిత ఉపదేశకులతో నిండిన సంఘం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "రచనా కాలం వివాదాస్పదం; మొదటి శతాబ్ది మధ్య లేదా చివర.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "యూదా విశ్వాసులు విశ్వాసం కోసం పోరాడి, అనైతిక అబద్ధ ఉపదేశకులను ఎదిరించి, దేవుని ప్రేమలో నిలిచి ఉండమని కోరుతాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "2 పేతురుతో పదార్థం, ఆందోళనలు పంచుకుంటుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "విశ్వాసం రక్షించబడాలి, విశ్వాసులు కృపలో నిలపబడాలి.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "యూదా విశ్వాసులు విశ్వాసం కోసం పోరాడి, అనైతిక అబద్ధ ఉపదేశకులను ఎదిరించి, దేవుని ప్రేమలో నిలిచి ఉండమని కోరుతాడు.",
            "claim_keys": [],
            "open_question_key": null
          }
        },
        "review_status": "draft"
