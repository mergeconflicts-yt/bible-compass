        "orientation": {
          "who": {
            "text": "దేవుడు, పౌలు, తిమోతి, ఎఫెసు సంఘం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "సంఘ నిరంతర జీవితం కోసం రాయబడింది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 62-66.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "పౌలు తిమోతికి స్వస్థ బోధ, సంఘ క్రమం, నాయకత్వ అర్హతలు, భక్తి గురించి సూచనలు ఇస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "పౌలు పరిచర్య, తిమోతి పాత్ర తర్వాత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
