    "passage_contexts": [
      {
        "context_key": "context:te:wb-hag",
        "scope_key": "scope:wb-hag:refsys:tel-v1:hag.1.1-hag.2.23",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, హగ్గయి, జెరుబ్బాబెలు, యెహోషువ.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "చెర అనంతర యెరూషలేము.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "క్రీ.పూ. 520, దర్యావేషు రెండవ సంవత్సరం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "హగ్గయి తిరిగివచ్చిన ప్రజలను ఆలయాన్ని పునర్నిర్మించమని పిలిచి, దేవుని సన్నిధి, ఆశీర్వాదాన్ని వాగ్దానం చేస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "చెర నుండి తిరిగి వచ్చి ఆలయ పని ఆగిన తరువాత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "దేవుని ఇంటికి ప్రాధాన్యం ఇవ్వడం నిబంధన ఆశీర్వాదాన్ని తెస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "హగ్గయి తిరిగివచ్చిన ప్రజలను ఆలయాన్ని పునర్నిర్మించమని పిలిచి, దేవుని సన్నిధి, ఆశీర్వాదాన్ని వాగ్దానం చేస్తాడు.",
