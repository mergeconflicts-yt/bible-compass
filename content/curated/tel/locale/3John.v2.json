        "entity_key": "entity:p-john-2",
        "language_tag": "te",
        "preferred_name": "యోహాను",
        "aliases": [],
        "short_description": {
          "text": "యోహాను, యోహాను రాసిన మూడవ పత్రిక గ్రంథంలో పేర్కొనబడిన వ్యక్తి.",
          "claim_keys": []
        },
        "extended_description": null,
        "review_status": "draft"
      }
    ],
    "passage_contexts": [
      {
        "context_key": "context:te:wb-3john",
        "scope_key": "scope:wb-3john:refsys:tel-v1:3john.1.1-3john.1.15",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, పెద్ద, గాయును, దియొత్రెఫెసు, దెమేత్రియు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "సంఘ వలయాలు, ప్రయాణ మిషనరీలు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 85-100.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "యోహాను గాయును ఆతిథ్యం, విశ్వసనీయతకు మెచ్చుకొని, దియొత్రెఫెసును గద్దించి, దెమేత్రియును మెచ్చుకుంటాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "1, 2 యోహానులతో సంబంధం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "విశ్వసనీయ ఆతిథ్యం సత్యాన్ని ఆదుకుంటుంది; అహంకారం సంఘానికి హాని.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "యోహాను గాయును ఆతిథ్యం, విశ్వసనీయతకు మెచ్చుకొని, దియొత్రెఫెసును గద్దించి, దెమేత్రియును మెచ్చుకుంటాడు.",
            "claim_keys": [],
            "open_question_key": null
          }
        },
        "review_status": "draft"
      },
