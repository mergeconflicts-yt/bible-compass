        "preferred_name": "లెబానోను",
        "aliases": [],
        "short_description": {
          "text": "లెబానోను, హబక్కూకు గ్రంథంలో పేర్కొనబడిన స్థలం.",
          "claim_keys": []
        },
        "extended_description": null,
        "review_status": "draft"
      }
    ],
    "passage_contexts": [
      {
        "context_key": "context:te:wb-hab",
        "scope_key": "scope:wb-hab:refsys:tel-v1:hab.1.1-hab.3.19",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, హబక్కూకు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "యూదా మరియు బబులోను ఉదయం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "క్రీ.పూ. ఏడవ శతాబ్ది చివర, బబులోను దాడికి ముందు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "హబక్కూకు అన్యాయం, హింస గురించి దేవుడిని ప్రశ్నించగా, నీతిమంతుడు విశ్వాసంతో జీవిస్తాడని జవాబు పొంది, నమ్మకంతో ముగిస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "బబులోను ఉదయానికి ముందు న్యాయ క్షీణతను ఉద్దేశిస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "సమయం స్పష్టం కానప్పుడు కూడా విశ్వాసం దేవుని న్యాయాన్ని నమ్ముతుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "హబక్కూకు అన్యాయం, హింస గురించి దేవుడిని ప్రశ్నించగా, నీతిమంతుడు విశ్వాసంతో జీవిస్తాడని జవాబు పొంది, నమ్మకంతో ముగిస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          }
        },
        "review_status": "draft"
