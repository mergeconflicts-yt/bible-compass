      {
        "context_key": "context:te:wb-mal",
        "scope_key": "scope:wb-mal:refsys:tel-v1:mal.1.1-mal.4.6",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, ప్రవక్త, యాజకులు, ప్రజలు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "యెరూషలేము మరియు దాని ఆలయం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "పర్షియా కాలం, సుమారు క్రీ.పూ. ఐదవ శతాబ్ది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "మలాకీ అర్ధహృదయ ఆరాధనను, అవిశ్వసనీయతను ఎదిరించి, దూతను, యెహోవా దినాన్ని వాగ్దానం చేస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "పునరుద్ధరణ తర్వాత ప్రవచన యుగాన్ని ముగిస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "నిజ ఆరాధనకు పిలుపు, యెహోవా దూతకు సిద్ధత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "మలాకీ అర్ధహృదయ ఆరాధనను, అవిశ్వసనీయతను ఎదిరించి, దూతను, యెహోవా దినాన్ని వాగ్దానం చేస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          }
        },
        "review_status": "draft"
      },
