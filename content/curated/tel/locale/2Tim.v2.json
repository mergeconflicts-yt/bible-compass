    "passage_contexts": [
      {
        "context_key": "context:te:wb-2tim",
        "scope_key": "scope:wb-2tim:refsys:tel-v1:2tim.1.1-2tim.4.22",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, పౌలు, తిమోతి, ఒనేసిఫోరు, సంఘాలు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "రోమాలో చెర నుండి రాయబడింది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 64-67, పౌలు మరణానికి దగ్గరగా.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "పౌలు తుది లేఖ తిమోతిని సువార్తను కాపాడి, శ్రమలను భరించి, వాక్యాన్ని విశ్వాసంగా ప్రకటించమని కోరుతుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "పౌలు హత్యను ముందుగా సూచిస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "సువార్త చివరి వరకు అప్పగించబడాలి, రక్షించబడాలి.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "పౌలు తుది లేఖ తిమోతిని సువార్తను కాపాడి, శ్రమలను భరించి, వాక్యాన్ని విశ్వాసంగా ప్రకటించమని కోరుతుంది.",
