    "passage_contexts": [
      {
        "context_key": "context:te:wb-ruth",
        "scope_key": "scope:wb-ruth:refsys:tel-v1:ruth.1.1-ruth.4.22",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "రూతు, నయోమి, బోయజు, దేవుడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "మోయాబు మరియు యూదాలోని బెత్లెహేము.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "న్యాయాధిపతుల కాలంలో; రచనా కాలం వివాదాస్పదం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "మోయాబు విధవరాలు రూతు నమ్మకంగా ఇశ్రాయేలులో చేరి, బోయజు పొలంలో మెలకువోడి, విమోచన ద్వారా దావీదు పూర్వికురాలవుతుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "న్యాయాధిపతుల కాలంలో సంభవిస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "నిబంధన విశ్వసనీయత మరియు జాతి హద్దులను దాటే దేవుని సంరక్షణ.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "మోయాబు విధవరాలు రూతు నమ్మకంగా ఇశ్రాయేలులో చేరి, బోయజు పొలంలో మెలకువోడి, విమోచన ద్వారా దావీదు పూర్వికురాలవుతుంది.",
            "claim_keys": [],
