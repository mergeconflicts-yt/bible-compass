        "preferred_name": "పౌలు",
        "aliases": [],
        "short_description": {
          "text": "పౌలు, తీతుకు రాసిన పత్రిక గ్రంథంలో పేర్కొనబడిన వ్యక్తి.",
          "claim_keys": []
        },
        "extended_description": null,
        "review_status": "draft"
      }
    ],
    "passage_contexts": [
      {
        "context_key": "context:te:wb-titus",
        "scope_key": "scope:wb-titus:refsys:tel-v1:titus.1.1-titus.3.15",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, పౌలు, తీతు, క్రేతు సంఘాలు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "క్రేతు ద్వీపం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 62-64.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "పౌలు తీతును పెద్దలను నియమించి, స్వస్థ బోధ నేర్పి, క్రేతులో సత్క్రియలను పెంచమని ఆదేశిస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "క్రేతులో పౌలు పరిచర్య తర్వాత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "ఆరోగ్యకర సంఘాలకు మంచి నాయకత్వం, భక్తిగల జీవితం అవసరం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "పౌలు తీతును పెద్దలను నియమించి, స్వస్థ బోధ నేర్పి, క్రేతులో సత్క్రియలను పెంచమని ఆదేశిస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          }
        },
        "review_status": "draft"
