        "entity_key": "entity:p-saul-2",
        "language_tag": "te",
        "preferred_name": "పౌలు",
        "aliases": [],
        "short_description": {
          "text": "పౌలు, కొలస్సయులకు రాసిన పత్రిక గ్రంథంలో పేర్కొనబడిన వ్యక్తి.",
          "claim_keys": []
        },
        "extended_description": null,
        "review_status": "draft"
      }
    ],
    "passage_contexts": [
      {
        "context_key": "context:te:wb-col",
        "scope_key": "scope:wb-col:refsys:tel-v1:col.1.1-col.4.18",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, పౌలు, యేసు, ఎపఫ్రా, కొలస్సీ సంఘం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "అబద్ధ బోధలకు వ్యతిరేకంగా చెర నుండి రాయబడింది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 60-62.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "పౌలు అన్ని శక్తులపై క్రీస్తు శ్రేష్ఠతను చూపి, విశ్వాసులు పాత జీవితాన్ని విడిచి ఆయనలో జీవించాలని పిలుస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "ప్రత్యర్థి తత్వాలను ఎదుర్కొంటున్న కొత్త సంఘాన్ని ఉద్దేశిస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "క్రీస్తు సరిపోతాడు; విశ్వాసులు ఆయనలో పరిపూర్ణులు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "పౌలు అన్ని శక్తులపై క్రీస్తు శ్రేష్ఠతను చూపి, విశ్వాసులు పాత జీవితాన్ని విడిచి ఆయనలో జీవించాలని పిలుస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          }
        },
        "review_status": "draft"
      },
