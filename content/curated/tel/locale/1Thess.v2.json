    "passage_contexts": [
      {
        "context_key": "context:te:wb-1thess",
        "scope_key": "scope:wb-1thess:refsys:tel-v1:1thess.1.1-1thess.5.28",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, పౌలు, సీల్వాను, తిమోతి, థెస్సలొనీకయులు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "పౌలు తొందరగా నగరం విడిచిన తర్వాత రాయబడింది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 50-51, పౌలు తొలి లేఖ కావచ్చు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "పౌలు చిన్న సంఘాన్ని ప్రోత్సహించి, వారి విశ్వాసాన్ని మెచ్చుకొని, క్రీస్తు తిరిగి రావడం, పరిశుద్ధ జీవితం గురించి జవాబిస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "అపొస్తలుల కార్యాల్లో సంఘ స్థాపన తర్వాత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "సంఘం క్రీస్తు కోసం నిరీక్షణలో నిలిచి ఉండాలి.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "పౌలు చిన్న సంఘాన్ని ప్రోత్సహించి, వారి విశ్వాసాన్ని మెచ్చుకొని, క్రీస్తు తిరిగి రావడం, పరిశుద్ధ జీవితం గురించి జవాబిస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          }
        },
        "review_status": "draft"
      },
