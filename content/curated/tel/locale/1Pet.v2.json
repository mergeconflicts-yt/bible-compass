      {
        "context_key": "context:te:wb-1pet",
        "scope_key": "scope:wb-1pet:refsys:tel-v1:1pet.1.1-1pet.5.14",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, పేతురు, యేసు, ఎన్నుకోబడిన పరదేశులు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "సామాజిక ఒత్తిడిలోని సమాజాలు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 60-65.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "పేతురు శ్రమపడుతున్న విశ్వాసులను పరదేశులుగా ప్రోత్సహించి, క్రీస్తు పునరుత్థాన నిరీక్షణపై ఆధారపడి పరిశుద్ధ ప్రవర్తనకు పిలుస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "పెరుగుతున్న హింసను ఉద్దేశిస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "క్రీస్తు కోసం శ్రమ ఆయన మహిమ, నిరీక్షణతో కలుపబడుతుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "పేతురు శ్రమపడుతున్న విశ్వాసులను పరదేశులుగా ప్రోత్సహించి, క్రీస్తు పునరుత్థాన నిరీక్షణపై ఆధారపడి పరిశుద్ధ ప్రవర్తనకు పిలుస్తాడు.",
