        "language_tag": "te",
        "preferred_name": "పౌలు",
        "aliases": [],
        "short_description": {
          "text": "పౌలు, ఫిలేమోనుకు రాసిన పత్రిక గ్రంథంలో పేర్కొనబడిన వ్యక్తి.",
          "claim_keys": []
        },
        "extended_description": null,
        "review_status": "draft"
      }
    ],
    "passage_contexts": [
      {
        "context_key": "context:te:wb-phlm",
        "scope_key": "scope:wb-phlm:refsys:tel-v1:phlm.1.1-phlm.1.25",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, పౌలు, ఫిలేమోను, ఒనేసిము, తిమోతి.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "చెర నుండి రాయబడింది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 60-62.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "పౌలు ఫిలేమోనును పారిపోయిన బానిస ఒనేసిమును ప్రియ సోదరునిగా స్వీకరించమని విజ్ఞప్తి చేస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "పౌలు చెర, కొలస్సీ సంఘంతో సంబంధం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "సువార్త సంబంధాలను, యాజమాన్యాన్ని మారుస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "పౌలు ఫిలేమోనును పారిపోయిన బానిస ఒనేసిమును ప్రియ సోదరునిగా స్వీకరించమని విజ్ఞప్తి చేస్తాడు.",
            "claim_keys": [],
