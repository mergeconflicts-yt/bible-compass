        "language_tag": "te",
        "preferred_name": "యోనా",
        "aliases": [],
        "short_description": {
          "text": "యోనా, యోనా గ్రంథంలో పేర్కొనబడిన వ్యక్తి.",
          "claim_keys": []
        },
        "extended_description": null,
        "review_status": "draft"
      }
    ],
    "passage_contexts": [
      {
        "context_key": "context:te:wb-jon",
        "scope_key": "scope:wb-jon:refsys:tel-v1:jon.1.1-jon.4.11",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, యోనా, నావికులు, నీనెవె.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "యొప్పా, సముద్రం, చేప, నీనెవె.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "క్రీ.పూ. ఎనిమిదవ శతాబ్ది; రచనా కాలం వివాదాస్పదం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "యోనా దేవుని పిలుపు నుండి పారిపోయి, గొప్ప చేప మింగగా, నీనెవెకు ప్రకటించి, దేవుని కరుణకు కోపగించుకుంటాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "అష్షూరు శక్తి కాలంలో సంభవిస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "దేవుడు సమస్త జాతులపై చూపే శ్రద్ధ, యోనా అయిష్ట హృదయం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "యోనా దేవుని పిలుపు నుండి పారిపోయి, గొప్ప చేప మింగగా, నీనెవెకు ప్రకటించి, దేవుని కరుణకు కోపగించుకుంటాడు.",
            "claim_keys": [],
            "open_question_key": null
          }
        },
        "review_status": "draft"
      },
