        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, విలాపకుడు, సీయోను కుమార్తె.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "శిథిలమైన యెరూషలేము.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "క్రీ.పూ. 586లో యెరూషలేము నాశనం తర్వాత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "యెరూషలేము నాశనాన్ని ఐదు విలాపాలు స్మరించి, పాపాన్ని అంగీకరించి, దేవుని స్థిరమైన ప్రేమ వైపు చేరుతాయి.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "బబులోను నాశనం తరువాత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "కృపను పట్టుకుంటూ దుఃఖానికి స్వరం ఇస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "యెరూషలేము నాశనాన్ని ఐదు విలాపాలు స్మరించి, పాపాన్ని అంగీకరించి, దేవుని స్థిరమైన ప్రేమ వైపు చేరుతాయి.",
