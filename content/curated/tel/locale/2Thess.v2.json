        "preferred_name": "పౌలు",
        "aliases": [],
        "short_description": {
          "text": "పౌలు, తెస్సలోనీకయులకు రాసిన రెండవ పత్రిక గ్రంథంలో పేర్కొనబడిన వ్యక్తి.",
          "claim_keys": []
        },
        "extended_description": null,
        "review_status": "draft"
      }
    ],
    "passage_contexts": [
      {
        "context_key": "context:te:wb-2thess",
        "scope_key": "scope:wb-2thess:refsys:tel-v1:2thess.1.1-2thess.3.18",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, పౌలు, థెస్సలొనీకయులు, అధర్మ మనుష్యుడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "1 థెస్సలొనీకయుల తర్వాత కొద్దికాలానికి రాయబడింది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 51-52.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "పౌలు థెస్సలొనీకయులకు ప్రభువు దినం గురించి భరోసా ఇచ్చి, స్థిరమైన, క్రమబద్ధ జీవితానికి పిలుస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "క్రీస్తు తిరిగి రావడం గురించి అపార్థాన్ని సరిదిద్దుతుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "ప్రభువు కోసం నిరీక్షిస్తూ ఓపికగా విశ్వసనీయత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "పౌలు థెస్సలొనీకయులకు ప్రభువు దినం గురించి భరోసా ఇచ్చి, స్థిరమైన, క్రమబద్ధ జీవితానికి పిలుస్తాడు.",
            "claim_keys": [],
