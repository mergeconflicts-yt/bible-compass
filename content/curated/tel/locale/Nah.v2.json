      {
        "context_key": "context:te:wb-nah",
        "scope_key": "scope:wb-nah:refsys:tel-v1:nah.1.1-nah.3.19",
        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, నహూము, నీనెవె.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "అష్షూరు రాజధాని నీనెవె.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "క్రీ.పూ. ఏడవ శతాబ్ది, నీనెవె పతనం (612 క్రీ.పూ.) కి ముందు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "నహూము నీనెవె పతనాన్ని ప్రకటించి, హింసాత్మక సామ్రాజ్యంపై దేవుని ప్రతిక్రియను, తన ప్రజలకు సువార్తను తెలుపుతాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "అష్షూరు యూదాపై చూపిన అణచివేత తరువాత.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "దేవుడు తన ప్రజలకు ఆశ్రయం, క్రూర అధికారానికి తీర్పు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "నహూము నీనెవె పతనాన్ని ప్రకటించి, హింసాత్మక సామ్రాజ్యంపై దేవుని ప్రతిక్రియను, తన ప్రజలకు సువార్తను తెలుపుతాడు.",
