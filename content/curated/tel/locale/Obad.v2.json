        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, ఓబద్యా, ఎదోము, యాకోబు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "ఎదోము మరియు సీయోను.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సుమారు యెరూషలేము పతనం (క్రీ.పూ. 586) తర్వాత లేదా ముందు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "ఓబద్యా యాకోబుపై ఎదోమును హింసించినందుకు తీర్పును, సీయోను కొండపై విడుదలను ప్రకటిస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "యెరూషలేము సంక్షోభంలో ఎదోము పాత్రను ఉద్దేశిస్తుంది.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "దేవుడు తన ప్రజలను కాపాడి, హింసకులను తీర్చుతాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "immediate_summary": {
            "text": "ఓబద్యా యాకోబుపై ఎదోమును హింసించినందుకు తీర్పును, సీయోను కొండపై విడుదలను ప్రకటిస్తాడు.",
