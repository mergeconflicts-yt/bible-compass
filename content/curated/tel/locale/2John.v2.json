        "language_tag": "te",
        "orientation": {
          "who": {
            "text": "దేవుడు, యేసు, పెద్ద, ఎన్నుకోబడిన అమ్మగారు, సంఘం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "where": {
            "text": "ప్రయాణ అబద్ధ ఉపదేశకులను ఎదుర్కొంటున్న సమాజం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "when": {
            "text": "సాధారణంగా క్రీ.శ. 85-100.",
            "claim_keys": [],
            "open_question_key": null
          },
          "what": {
            "text": "యోహాను ఎన్నుకోబడిన అమ్మగారికి, ఆమె పిల్లలకు ప్రేమ, సత్యం ప్రోత్సహించి, మోసగాళ్లపై హెచ్చరిస్తాడు.",
            "claim_keys": [],
            "open_question_key": null
          },
          "before": {
            "text": "1, 3 యోహానులతో సంబంధం.",
            "claim_keys": [],
            "open_question_key": null
          },
          "stakes": {
            "text": "సత్యం, ప్రేమ కలిసి కాపాడబడాలి.",
