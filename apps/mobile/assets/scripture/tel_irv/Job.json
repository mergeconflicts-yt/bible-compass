n":31,"text":""},{"t":"v","n":32,"text":""},{"t":"v","n":33,"text":""},{"t":"v","n":34,"text":""},{"t":"v","n":35,"text":""},{"t":"v","n":36,"text":""},{"t":"v","n":37,"text":""},{"t":"v","n":38,"text":""},{"t":"v","n":39,"text":""},{"t":"v","n":40,"text":""},{"t":"v","n":41,"text":""}]},{"n":39,"blocks":[{"t":"v","n":1,"text":"అడవిలోని కొండమేకలు ఈనే కాలం నీకు తెలుసా? లేళ్లు పిల్లలు పెట్టే కాలం నువ్వు గ్రహించగలవా?"},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"v","n":28,"text":""},{"t":"v","n":29,"text":""},{"t":"v","n":30,"text":""}]},{"n":40,"blocks":[{"t":"v","n":1,"text":"యెహోవా యోబుకు ఇలా జవాబు ఇచ్చాడు."},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""}]},{"n":41,"blocks":[{"t":"v","n":1,"text":"నువ్వు జలరాక్షసిని గాలంతో లాగగలవా? దాని దవడలను తాడుతో బిగించగలవా?"},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"v","n":28,"text":""},{"t":"v","n":29,"text":""},{"t":"v","n":30,"text":""},{"t":"v","n":31,"text":""},{"t":"v","n":32,"text":""},{"t":"v","n":33,"text":""},{"t":"v","n":34,"text":""}]},{"n":42,"blocks":[{"t":"h","text":"యోబు పశ్చాత్తాపం"},{"t":"v","n":1,"text":"అప్పుడు యోబు యెహోవాకు ఇలా జవాబిచ్చాడు."},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":"యెహోవా యోబుతో ఆ మాటలు పలికిన తరువాత ఆయన తేమానీయుడు ఎలీఫజుతో ఇలా చెప్పాడు. “నా సేవకుడైన యోబు పలికినట్టు మీరు నన్ను గూర్చి యుక్తమైనది పలకలేదు కాబట్టి నా కోపం నీ మీదా నీ ఇద్దరు స్నేహితుల మీదా మండుతున్నది."},{"t":"v","n":8,"text":"కాబట్టి ఏడు ఎద్దులను ఏడు పొట్టేళ్లను తీసుకుని, నా సేవకుడు యోబు దగ్గరికి పోయి మీ నిమిత్తం దహనబలి అర్పించాలి. అప్పుడు నా సేవకుడు యోబు మీ పక్షంగా ప్రార్థన చేస్తాడు. మీ అవివేకాన్ని బట్టి నేను మిమ్మల్ని శిక్షించకుండా నేను అతని ప్రార్థన మాత్రం అంగీకరిస్తాను. ఎందుకంటే నా సేవకుడు యోబు పలికినట్లు మీరు నన్ను గూర్చి యుక్తమైనది పలక లేదు.”"},{"t":"v","n":9,"text":"తేమానీయుడు ఎలీఫజు, షూహీయుడు బిల్దదు, నయమాతీయుడు జోఫరు పోయి, యెహోవా తమకు ఆజ్ఞాపించినట్టు చేశారు. యెహోవా వారి పక్షాన యోబును అంగీకరించాడు."},{"t":"h","text":"యెహోవా యోబును ఆశీర్వదించడం"},{"t":"v","n":10,"text":"యోబు తన స్నేహితుల నిమిత్తం ప్రార్థన చేసినప్పుడు యెహోవా అతని క్షేమ స్థితిని మళ్ళీ అతనికి దయచేశాడు. యోబుకు పూర్వం కలిగిన దానికంటే రెండంతలు అధికంగా యెహోవా అతనికి దయచేశాడు."},{"t":"v","n":11,"text":"అప్పుడు అతని అన్నదమ్ములు, అతని అక్క చెల్లెళ్ళు అంతకుముందు అతనికి పరిచయం ఉన్న వారంతా వచ్చి, అతనితో కలిసి అతని ఇంట్లో భోజనాలు చేశారు. యెహోవా అతని మీదికి రప్పించిన బాధలన్నిటి గూర్చి ఎంత కష్టాల పాలయ్యావు అంటూ అతని కోసం దుఃఖిస్తూ అతణ్ణి ఓదార్చారు. అంతేగాక ఒక్కొక్కడు ఒక వెండి నాణెం, బంగారు ఉంగరం అతనికి ఇచ్చారు."},{"t":"v","n":12,"text":"యెహోవా యోబును మొదట ఆశీర్వదించినంత కంటే మరి ఎక్కువగా ఆశీర్వదించాడు. అతనికి పద్నాలుగు వేల గొర్రెలు, ఆరు వేల ఒంటెలు, వెయ్యి జతల ఎడ్లు, వెయ్యి ఆడగాడిదలు ఉన్నాయి."},{"t":"v","n":13,"text":"అతనికి ఏడుగురు కొడుకులు, ముగ్గురు కూతుళ్ళు పుట్టారు."},{"t":"v","n":14,"text":"అతడు పెద్ద కూతురికి ఎమీమా అనీ రెండవ కూతురికి కెజీయా అనీ మూడవ కూతురికి కెరెన్ హపుక్ అనీ పేర్లు పెట్టాడు."},{"t":"v","n":15,"text":"ఆ దేశమంతటా యోబు కుమార్తెలంత లావణ్యవతులు కనబడలేదు. వారి తండ్రి వారి అన్నదమ్ములతో పాటు వారికి వారసత్వాలు ఇచ్చాడు."},{"t":"v","n":16,"text":"ఆ పైన యోబు నూట నలభై సంవత్సరాలు బతికి, తన కొడుకులను, మనవళ్ళను నాలుగు తరాల వరకూ చూశాడు."},{"t":"v","n":17,"text":"తరువాత యోబు కాలం నిండిన వృద్ధుడై తనువు చాలించాడు."}]}]}