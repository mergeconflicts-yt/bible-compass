{"osis":"Nah","bsb":"NAM","name":"Nahum","chapters":[{"n":1,"blocks":[{"t":"h","text":"The Burden against Nineveh"},{"t":"v","n":1,"text":"This is the burden against Nineveh, the book of the vision of Nahum the Elkoshite:"},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":"This is what the LORD says:"},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":"The LORD has issued a command concerning you, O Nineveh:"},{"t":"v","n":15,"text":""}]},{"n":2,"blocks":[{"t":"h","text":"The Overthrow of Nineveh"},{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""}]},{"n":3,"blocks":[{"t":"h","text":"Judgment on Nineveh"},{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""}]}]}