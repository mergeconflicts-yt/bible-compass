"t":"v","n":31,"text":""},{"t":"v","n":32,"text":""},{"t":"v","n":33,"text":""},{"t":"v","n":34,"text":""}]},{"n":25,"blocks":[{"t":"h","text":"More Proverbs of Solomon"},{"t":"v","n":1,"text":"These are additional proverbs of Solomon, which were copied by the men of Hezekiah king of Judah:"},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"v","n":28,"text":""}]},{"n":26,"blocks":[{"t":"h","text":"Similitudes and Instructions"},{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"v","n":28,"text":""}]},{"n":27,"blocks":[{"t":"h","text":"Do Not Boast about Tomorrow"},{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""}]},{"n":28,"blocks":[{"t":"h","text":"The Boldness of the Righteous"},{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"v","n":28,"text":""}]},{"n":29,"blocks":[{"t":"h","text":"The Flourishing of the Righteous"},{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""}]},{"n":30,"blocks":[{"t":"h","text":"The Words of Agur"},{"t":"v","n":1,"text":"These are the words of Agur son of Jakeh—the burden that this man declared to Ithiel:"},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":"There are three things that are never satisfied, four that never say, ‘Enough!’:"},{"t":"v","n":16,"text":"Sheol, the barren womb, land never satisfied with water, and fire that never says, ‘Enough!’"},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":"There are three things too wonderful for me, four that I cannot understand:"},{"t":"v","n":19,"text":"the way of an eagle in the sky, the way of a snake on a rock, the way of a ship at sea, and the way of a man with a maiden."},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":"Under three things the earth trembles, under four it cannot bear up:"},{"t":"v","n":22,"text":"a servant who becomes king, a fool who is filled with food,"},{"t":"v","n":23,"text":"an unloved woman who marries, and a maidservant who supplants her mistress."},{"t":"v","n":24,"text":"Four things on earth are small, yet they are exceedingly wise:"},{"t":"v","n":25,"text":"The ants are creatures of little strength, yet they store up their food in the summer;"},{"t":"v","n":26,"text":"the rock badgers are creatures of little power, yet they make their homes in the rocks;"},{"t":"v","n":27,"text":"the locusts have no king, yet they all advance in formation;"},{"t":"v","n":28,"text":"and the lizard can be caught in one’s hands, yet it is found in the palaces of kings."},{"t":"v","n":29,"text":"There are three things that are stately in their stride, and four that are impressive in their walk:"},{"t":"v","n":30,"text":"a lion, mighty among beasts, refusing to retreat before anything;"},{"t":"v","n":31,"text":"a strutting rooster; a he-goat; and a king with his army around him."},{"t":"v","n":32,"text":""},{"t":"v","n":33,"text":""}]},{"n":31,"blocks":[{"t":"h","text":"The Sayings for King Lemuel"},{"t":"v","n":1,"text":"These are the words of King Lemuel—the burden that his mother taught him:"},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"h","text":"The Virtues of a Noble Woman"},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"v","n":28,"text":""},{"t":"v","n":29,"text":""},{"t":"v","n":30,"text":""},{"t":"v","n":31,"text":""}]}]}