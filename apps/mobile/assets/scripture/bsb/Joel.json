{"osis":"Joel","bsb":"JOL","name":"Joel","chapters":[{"n":1,"blocks":[{"t":"h","text":"The Invasion of Locusts"},{"t":"v","n":1,"text":"This is the word of the LORD that came to Joel son of Pethuel:"},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"h","text":"A Call to Mourning"},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"h","text":"A Call to Repentance"},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""}]},{"n":2,"blocks":[{"t":"h","text":"The Army of Locusts"},{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"h","text":"Return with All Your Heart"},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"h","text":"Restoration Promised"},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"h","text":"I Will Pour Out My Spirit"},{"t":"v","n":28,"text":""},{"t":"v","n":29,"text":""},{"t":"v","n":30,"text":""},{"t":"v","n":31,"text":""},{"t":"v","n":32,"text":""}]},{"n":3,"blocks":[{"t":"h","text":"The LORD Judges the Nations"},{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":"Now what do you have against Me, O Tyre, Sidon, and all the regions of Philistia? Are you rendering against Me a recompense? If you retaliate against Me, I will swiftly and speedily return your recompense upon your heads."},{"t":"v","n":5,"text":"For you took My silver and gold and carried off My finest treasures to your temples."},{"t":"v","n":6,"text":"You sold the people of Judah and Jerusalem to the Greeks, to send them far from their homeland."},{"t":"v","n":7,"text":"Behold, I will rouse them from the places to which you sold them; I will return your recompense upon your heads."},{"t":"v","n":8,"text":"I will sell your sons and daughters into the hands of the people of Judah, and they will sell them to the Sabeans—to a distant nation.” Indeed, the LORD has spoken."},{"t":"v","n":9,"text":"Proclaim this among the nations:"},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"h","text":"Blessings for God’s People"},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":"For the LORD dwells in Zion."}]}]}