{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"v","n":28,"text":""},{"t":"v","n":29,"text":""},{"t":"v","n":30,"text":""},{"t":"v","n":31,"text":""},{"t":"v","n":32,"text":""},{"t":"v","n":33,"text":""},{"t":"v","n":34,"text":""}]},{"n":42,"blocks":[{"t":"h","text":"யோபுவின் வார்த்தைகள்"},{"t":"v","n":1,"text":"அப்பொழுது யோபு யெகோவாவுக்கு மறுமொழியாக:"},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"h","text":"முடிவுரை"},{"t":"v","n":7,"text":"யெகோவா இந்த வார்த்தைகளை யோபுடன் பேசினபின், யெகோவா தேமானியனான எலிப்பாசை நோக்கி: “உன்மேலும் உன் இரண்டு நண்பர்கள்மேலும் எனக்குக் கோபம் வருகிறது; என் ஊழியனாகிய யோபு பேசினதுபோல், நீங்கள் என்னைக்குறித்து நிதானமாகப் பேசவில்லை."},{"t":"v","n":8,"text":"ஆதலால் நீங்கள் ஏழு காளைகளையும், ஏழு ஆட்டுக்கடாக்களையும் தெரிந்துகொண்டு, என் தாசனாகிய யோபினிடத்தில் போய், உங்களுக்காகச் சர்வாங்க தகனபலிகளைச் செலுத்துங்கள்; என் தாசனாகிய யோபும் உங்களுக்காக வேண்டுதல் செய்வான்; நான் அவனுடைய முகத்தைப் பார்த்து, உங்களை உங்கள் புத்தியீனத்திற்கு ஏற்றவிதத்தில் நடத்தாதிருப்பேன்; என் ஊழியனாகிய யோபு பேசினதுபோல், நீங்கள் என்னைக்குறித்து நிதானமாகப் பேசவில்லை” என்றார்."},{"t":"v","n":9,"text":"அப்பொழுது தேமானியனான எலிப்பாசும் சூகியனான பில்தாதும் நாகமாத்தியனான சோப்பாரும்போய், யெகோவா தங்களுக்குச் சொன்னபடியே செய்தார்கள்; அப்பொழுது யெகோவா யோபின் முகத்தைப் பார்த்தார்."},{"t":"v","n":10,"text":"யோபு தன் நண்பனுக்காக வேண்டுதல் செய்தபோது, யெகோவா அவனுடைய சிறையிருப்பை மாற்றினார். யோபுக்கு முன் இருந்த எல்லாவற்றைவிட இரண்டுமடங்காகக் யெகோவா அவனுக்குத் தந்தருளினார்."},{"t":"v","n":11,"text":"அப்பொழுது அவனுடைய எல்லாச் சகோதரரும் சகோதரிகளும், முன்பு அவனுக்கு அறிமுகமான அனைவரும் அவனிடத்தில் வந்து, அவன் வீட்டிலே அவனுடன் உணவருந்தி, யெகோவா அவன்மேல் வரச்செய்த எல்லா பாதிப்பினால் அவனுக்காக அங்கலாய்த்து, அவனுக்கு ஆறுதல் சொல்லி, அவரவர் ஒவ்வொரு தங்கக்காசையும், அவரவர் ஒவ்வொரு பொன் ஆபரணத்தையும் அவனுக்குக் கொடுத்தார்கள்."},{"t":"v","n":12,"text":"யெகோவா யோபின் முன்னிலைமையைப் பார்க்கிலும் அவனுடைய பின்னிலைமையை ஆசீர்வதித்தார்; பதினான்காயிரம் ஆடுகளும், ஆறாயிரம் ஒட்டகங்களும், ஆயிரம் ஏர்மாடுகளும், ஆயிரம் கழுதைகளும் அவனுக்கு இருந்தது."},{"t":"v","n":13,"text":"ஏழு மகன்களும் மூன்று மகள்களும் அவனுக்குப் பிறந்தார்கள்."},{"t":"v","n":14,"text":"மூத்த மகளுக்கு எமீமாள் என்றும், இரண்டாம் மகளுக்குக் கெத்சீயாள் என்றும், மூன்றாம் மகளுக்குக் கேரேனாப்புக் என்றும் பெயரிட்டான்."},{"t":"v","n":15,"text":"தேசத்தில் எங்கும் யோபின் மகள்களைப்போல அழகான பெண்கள் காணப்படவில்லை; அவர்கள் தகப்பன் அவர்கள் சகோதரரின் நடுவிலே அவர்களுக்கு சொத்துக்களைக் கொடுத்தான்."},{"t":"v","n":16,"text":"இதற்குப்பின்பு யோபு நூற்று நாற்பது வருடங்கள் உயிருடன் இருந்து, நான்கு தலைமுறையாகத் தன் பிள்ளைகளையும் தன் பிள்ளைகளுடைய பிள்ளைகளையும் கண்டான்."},{"t":"v","n":17,"text":"யோபு அதிக நாட்கள் இருந்து, பூரண வயதுள்ளவனாய் இறந்தான்."}]}]}