":30,"text":""},{"t":"v","n":31,"text":""},{"t":"v","n":32,"text":""},{"t":"v","n":33,"text":""},{"t":"v","n":34,"text":""},{"t":"v","n":35,"text":""},{"t":"v","n":36,"text":""},{"t":"v","n":37,"text":""},{"t":"v","n":38,"text":""},{"t":"v","n":39,"text":""},{"t":"v","n":40,"text":""}]},{"n":32,"blocks":[{"t":"h","text":"எலிகூவின் வார்த்தைகள்"},{"t":"v","n":1,"text":"யோபு தன் பார்வைக்கு நீதிமானாயிருந்ததினால், அவனுக்கு அந்த மூன்று மனிதரும் பதில் சொல்லி முடித்தார்கள்."},{"t":"v","n":2,"text":"அதினால் ராமின் வம்சத்தானாகிய பூசியனாகிய பரகெயேலின் மகன் எலிகூவுக்குக் கோபம் வந்தது, யோபு, தேவனைவிடத் தன்னைத்தான் நீதிமானாக்கினதினால், அவன்மேலும் அவனுக்குக் கோபம் வந்தது."},{"t":"v","n":3,"text":"கொடுக்கத்தக்க மறுமொழி யோபின் மூன்று நண்பர்களுக்கும் கிடைக்காதிருந்தும், அவர்கள் அவனை ஆகாதவனென்று முடிவு செய்ததால், அவர்கள்மேலும் அவனுக்குக் கோபம் வந்தது."},{"t":"v","n":4,"text":"அவர்கள் தன்னைவிட வயது முதிர்ந்தவர்களானதினால், எலிகூ யோபின் வார்த்தைகள் முடியும்வரை காத்திருந்தான்."},{"t":"v","n":5,"text":"அந்த மூன்று மனிதரின் வாயிலும் பதில் பிறக்கவில்லையென்று எலிகூ கண்டபோது, அவனுக்குக் கோபம் வந்தது."},{"t":"v","n":6,"text":"ஆதலால் பரகெயேலின் மகன் எலிகூ என்னும் பூசியன் மறுமொழியாக: நான் இளவயதுள்ளவன், நீங்களோ வயதானவர்கள்; ஆகையால் நான் பயந்து, என் கருத்தை உங்களுக்கு முன்பாக வெளிப்படுத்த பயந்திருந்தேன்."},{"t":"v","n":7,"text":"முதியோர் பேசட்டும், வயது சென்றவர்கள் ஞானத்தை அறிவிக்கட்டும் என்றிருந்தேன்."},{"t":"v","n":8,"text":"ஆனாலும் மனிதரில் ஒரு ஆவியுண்டு; சர்வவல்லமையுள்ள தேவனுடைய சுவாசமே அவர்களை உணர்வுள்ளவர்களாக்கும்."},{"t":"v","n":9,"text":"பெரியோரெல்லாம் ஞானிகளல்ல; முதியோரெல்லாம் நீதியை அறிந்தவர்களுமல்ல."},{"t":"v","n":10,"text":"ஆகையால் நான் சொல்வதைக் கேளுங்கள்; நானும் என் கருத்தை வெளிப்படுத்துவேன் என்றேன்."},{"t":"v","n":11,"text":"இதோ, உங்கள் வசனங்கள் முடியும்வரை காத்திருந்தேன்; நீங்கள் சொல்ல முடிந்ததை ஆராய்ந்து தேடும்வரை, உங்கள் நியாயங்களுக்குச் செவிகொடுத்தேன்."},{"t":"v","n":12,"text":"நான் உங்கள் சொல்லைக் கவனித்தேன்; ஆனாலும் இதோ, உங்களில் யோபுக்கு நியாயத்தைத் தெரிவித்து, அவருடைய வசனங்களுக்கு ஏற்ற மறுமொழி சொல்லுகிறவனில்லை."},{"t":"v","n":13,"text":"ஞானத்தைக் கண்டுபிடித்தோம் என்று நீங்கள் சொல்லாதபடி பாருங்கள்; மனிதனல்ல, தேவனே அவரை வெற்றி கொள்ளவேண்டும்."},{"t":"v","n":14,"text":"அவர் என்னைப்பார்த்துப் பேசினதில்லை; நீங்கள் சொன்ன வார்த்தைகளினால் நான் அவருக்கு மறுமொழி சொல்வதுமில்லை."},{"t":"v","n":15,"text":"அவர்கள் கலங்கி பிறகு மறுமொழி சொல்லாதிருக்கிறார்கள்; அவர்களுக்குப் பேச்சு நின்றுபோனது."},{"t":"v","n":16,"text":"அவர்கள் பேசமாட்டார்களா என்று காத்திருந்தேன்; ஆனாலும் அவர்கள் மறுமொழி கொடுக்காமலிருந்ததினால்,"},{"t":"v","n":17,"text":"நானும் மறுமொழியாக எனக்குத் தோன்றியவரை சொல்லுவேன்; நானும் என் கருத்தை வெளிப்படுத்துவேன்."},{"t":"v","n":18,"text":"வார்த்தைகள் எனக்குள் நிறைந்திருக்கிறது; என் உள்ளத்திலுள்ள ஆவி என்னை நெருக்கி ஏவுகிறது."},{"t":"v","n":19,"text":"இதோ, என் உள்ளம் அடைக்கப்பட்டிருந்து, புது தோல்பைகளையே கிழிக்கும் புதுரசத்தைப் போலிருக்கிறது."},{"t":"v","n":20,"text":"நான் ஆறுதலடையும்படி பேசுவேன்; என் உதடுகளைத் திறந்து மறுமொழி சொல்லுவேன்."},{"t":"v","n":21,"text":"நான் ஒருவனுடைய முகத்தைப் பார்க்காமலும், ஒரு மனிதனுக்கும் ஆசை வார்த்தை பேசாமலும் இருப்பேனாக."},{"t":"v","n":22,"text":"நான் ஆசை வார்த்தை பேச அறியேன்; பேசினால் என்னை உண்டாக்கினவர் சீக்கிரமாக என்னை எடுத்துக்கொள்வார்."}]},{"n":33,"blocks":[{"t":"v","n":1,"text":""},{"t":"v","n":2,"text":""},{"t":"v","n":3,"text":""},{"t":"v","n":4,"text":""},{"t":"v","n":5,"text":""},{"t":"v","n":6,"text":""},{"t":"v","n":7,"text":""},{"t":"v","n":8,"text":""},{"t":"v","n":9,"text":""},{"t":"v","n":10,"text":""},{"t":"v","n":11,"text":""},{"t":"v","n":12,"text":""},{"t":"v","n":13,"text":""},{"t":"v","n":14,"text":""},{"t":"v","n":15,"text":""},{"t":"v","n":16,"text":""},{"t":"v","n":17,"text":""},{"t":"v","n":18,"text":""},{"t":"v","n":19,"text":""},{"t":"v","n":20,"text":""},{"t":"v","n":21,"text":""},{"t":"v","n":22,"text":""},{"t":"v","n":23,"text":""},{"t":"v","n":24,"text":""},{"t":"v","n":25,"text":""},{"t":"v","n":26,"text":""},{"t":"v","n":27,"text":""},{"t":"v","n":28,"text":""},{"t":"v","n":29,"te