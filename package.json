{
  "private": true,
  "name": "bible-compass",
  "version": "1.0.0",
  "workspaces": [
    "packages/domain",
    "packages/content-schema",
    "packages/registry-service",
    "packages/acquisition",
    "packages/tvtms-adapter",
    "packages/tipnr-adapter",
    "packages/bibledata-adapter",
    "packages/macula-adapter",
    "packages/openbible-adapter",
    "packages/reconciliation",
    "packages/candidate-import",
    "packages/bundle-assembler",
    "packages/provider-runner",
    "packages/submission-validator"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck --workspaces --if-present && npm run lint --workspaces --if-present && npm run format:check && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "prettier": "3.9.6",
    "eslint": "9.39.5"
  }
}
